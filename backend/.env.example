# Run python start.py from the repository root; it configures admin / 123456.
# Model connection
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai_compatible
LLM_TEMPERATURE=0
LLM_SEED=42
# Local embedding and hybrid retrieval
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=256
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BACKEND=fastembed
QDRANT_DB_PATH=qdrant
CHILD_COLLECTION=document_child_chunks
DENSE_VECTOR_NAME=dense
SPARSE_MODEL=Qdrant/bm25
SPARSE_OFFLINE_FALLBACK=true
SPARSE_VECTOR_NAME=sparse
RETRIEVAL_TOP_K=7
RETRIEVAL_MIN_SCORE=0.4
# Logging, chunking and upload
EXECUTION_LOGGING_ENABLED=true
EXECUTION_LOG_MAX_CHARS=1200
CHILD_CHUNK_SIZE=500
CHILD_CHUNK_OVERLAP=100
PARENT_CHUNK_SIZE=3000
MAX_UPLOAD_BYTES=26214400
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
